  </joint>

  <joint name="joint_6" type="continuous">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin rpy="-1.570796 0 3.141593" xyz="0 0.10375 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="20.0" velocity="0.837758"/>
  </joint>

  <joint name="joint_7" type="fixed">
    <parent link="link_6"/>
