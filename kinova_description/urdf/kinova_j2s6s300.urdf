  <!-- JOINTS -->

  <joint name="virtual_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <joint name="joint_1" type="continuous">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin rpy="0 3.141593 0" xyz="0 0 0.15675"/>
    <axis xyz="0 0 1"/>
    <limit effort="40.0" velocity="0.628319"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin rpy="-1.570796 0 3.141593" xyz="0 0.0016 -0.11875"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.820305" upper="5.462881"
           effort="80.0" velocity="0.628319"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin rpy="0 3.141593 0" xyz="0 -0.410 0"/>
